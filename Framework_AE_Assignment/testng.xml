<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.1.dtd">
<suite name="PW_AE_Demo">

	<listeners>
		<listener class-name="framework.listeners.TestListener" />
	</listeners>

	<test name="AE_Website_Test">

		<parameter name="environment" value="qa" />
		
		<classes>
			<class name="test.SignupTest">
				<methods>
					<include name="Test_AE01_TC01_Verify_NewUser_SignUp" />
					<include name="Test_AE01_TC05_Signup_ExistingMail" />
				</methods>
			</class>

			<class name="test.LoginTest">
				<methods>
					<include name="Test_AE01_TC02_Verify_Login_CorrectDetails" />
					<include name="Test_AE01_TC03_Verify_Login_Incorrect_MailPwd" />
				</methods>
			</class>

			<class name="test.LogoutTest">
				<methods>
					<include name="Test_AE01_TC04_Verify_LogoutUser" />
				</methods>
			</class>

		</classes>

	</test>
</suite>
